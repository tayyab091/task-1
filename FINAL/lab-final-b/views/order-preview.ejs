<div class="container">
    <main>
        <div class="py-5 text-center">
            <h2>Order Preview</h2>
            <p class="lead">Review your order before confirming.</p>
        </div>

        <div class="row g-5">
            <div class="col-md-5 col-lg-4 order-md-last">
                <h4 class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-primary">Your cart</span>
                    <span class="badge bg-primary rounded-pill"><%= cartItems.length %></span>
                </h4>
                <ul class="list-group mb-3">
                    <% cartItems.forEach(item => { %>
                    <li class="list-group-item d-flex justify-content-between lh-sm">
                        <div>
                            <h6 class="my-0"><%= item.name %> (x<%= item.quantity || 1 %>)</h6>
                            <small class="text-body-secondary"><%= item.description %></small>
                        </div>
                        <span class="text-body-secondary">$<%= (item.price * (item.quantity || 1)).toFixed(2) %></span>
                    </li>
                    <% }); %>
                    <% if (discount > 0) { %>
                    <li class="list-group-item d-flex justify-content-between bg-body-tertiary">
                        <div class="text-success">
                            <h6 class="my-0">Discount (<%= coupon %>)</h6>
                        </div>
                        <span class="text-success">−$<%= discount.toFixed(2) %></span>
                    </li>
                    <% } %>
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Total (USD)</span>
                        <strong>$<%= total.toFixed(2) %></strong>
                    </li>
                </ul>
                <form class="card p-2 mb-3">
                    <div class="input-group">
                        <input type="text" class="form-control" name="coupon" placeholder="Promo code" value="<%= coupon %>">
                        <button type="submit" formaction="/order/preview" formmethod="GET" class="btn btn-secondary">Apply</button>
                    </div>
                </form>
                <div class="d-grid gap-2">
                    <form method="POST" action="/order/preview">
                        <input type="hidden" name="coupon" value="<%= coupon %>">
                        <input type="hidden" name="email" value="<%= email %>">
                        <button type="submit" class="btn btn-success">Confirm Order</button>
                    </form>
                    <a href="/checkout" class="btn btn-secondary">Go Back to Cart</a>
                </div>
            </div>

            <div class="col-md-7 col-lg-8">
                <h4 class="mb-3">Billing address</h4>
                <form id="checkoutForm" method="POST" action="/order/preview">
                    
                    <div class="mb-3">
                        <label for="fullname" class="form-label">Full Name</label>
                        <input type="text" class="form-control" id="fullname" name="fullname" value="<%= checkoutData ? checkoutData.fullname : '' %>">
                        <div class="invalid-feedback">Full name is required (at least 3 characters).</div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="text" class="form-control" id="email" name="email" value="<%= email %>">
                        <div class="invalid-feedback">Please enter a valid email address.</div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="phone" class="form-label">Phone</label>
                        <input type="text" class="form-control" id="phone" name="phone" value="<%= checkoutData ? checkoutData.phone : '' %>">
                        <div class="invalid-feedback">Phone must be at least 10 digits.</div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="address" class="form-label">Address</label>
                        <input type="text" class="form-control" id="address" name="address" value="<%= checkoutData ? checkoutData.address : '' %>">
                        <div class="invalid-feedback">Address is required.</div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="city" class="form-label">City</label>
                        <input type="text" class="form-control" id="city" name="city" value="<%= checkoutData ? checkoutData.city : '' %>">
                        <div class="invalid-feedback">City is required.</div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="postalcode" class="form-label">Postal Code</label>
                        <input type="text" class="form-control" id="postalcode" name="postalcode" value="<%= checkoutData ? checkoutData.postalcode : '' %>">
                        <div class="invalid-feedback">Postal code must be 4-6 digits.</div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="country" class="form-label">Country</label>
                        <select class="form-select" id="country" name="country">
                            <option value="">Choose...</option>
                            <option value="US" <%= checkoutData && checkoutData.country === 'US' ? 'selected' : '' %>>United States</option>
                            <option value="UK" <%= checkoutData && checkoutData.country === 'UK' ? 'selected' : '' %>>United Kingdom</option>
                            <option value="CA" <%= checkoutData && checkoutData.country === 'CA' ? 'selected' : '' %>>Canada</option>
                        </select>
                        <div class="invalid-feedback">Please select a country.</div>
                    </div>
                    
                    <h4 class="mb-3">Payment</h4>
                    
                    <div class="mb-3">
                        <div class="form-check">
                            <input id="credit" name="paymentMethod" type="radio" class="form-check-input" value="credit" <%= checkoutData && checkoutData.paymentMethod === 'credit' ? 'checked' : '' %>>
                            <label class="form-check-label" for="credit">Credit card</label>
                        </div>
                        <div class="form-check">
                            <input id="debit" name="paymentMethod" type="radio" class="form-check-input" value="debit" <%= checkoutData && checkoutData.paymentMethod === 'debit' ? 'checked' : '' %>>
                            <label class="form-check-label" for="debit">Debit card</label>
                        </div>
                        <div class="form-check">
                            <input id="paypal" name="paymentMethod" type="radio" class="form-check-input" value="paypal" <%= checkoutData && checkoutData.paymentMethod === 'paypal' ? 'checked' : '' %>>
                            <label class="form-check-label" for="paypal">PayPal</label>
                        </div>
                    </div>
                    
                    <div class="row gy-3" id="cardFields">
                        <div class="col-md-6">
                            <label for="cc-name" class="form-label">Name on card</label>
                            <input type="text" class="form-control" id="cc-name" name="cardname" value="<%= checkoutData ? checkoutData.cardname : '' %>">
                            <small class="text-body-secondary">Full name as displayed on card</small>
                            <div class="invalid-feedback">Name on card is required</div>
                        </div>
                        
                        <div class="col-md-6">
                            <label for="cc-number" class="form-label">Credit card number</label>
                            <input type="text" class="form-control" id="cc-number" name="cardnumber" value="<%= checkoutData ? checkoutData.cardnumber : '' %>">
                            <div class="invalid-feedback">Credit card number is required</div>
                        </div>
                        
                        <div class="col-md-3">
                            <label for="cc-expiration" class="form-label">Expiration</label>
                            <input type="text" class="form-control" id="cc-expiration" name="cardexpiration" placeholder="MM/YY" value="<%= checkoutData ? checkoutData.cardexpiration : '' %>">
                            <div class="invalid-feedback">Expiration date required</div>
                        </div>
                        
                        <div class="col-md-3">
                            <label for="cc-cvv" class="form-label">CVV</label>
                            <input type="text" class="form-control" id="cc-cvv" name="cardcvv" value="<%= checkoutData ? checkoutData.cardcvv : '' %>">
                            <div class="invalid-feedback">Security code required</div>
                        </div>
                    </div>
                    
                    <hr class="my-4">
                    
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="terms" name="terms" <%= checkoutData && checkoutData.terms ? 'checked' : '' %>>
                        <label class="form-check-label" for="terms">
                            I agree to the <a href="#">terms and conditions</a>
                        </label>
                    </div>
                    
                    <input type="hidden" name="coupon" value="<%= coupon %>">
                    
                    <button class="w-100 btn btn-primary btn-lg" type="submit">Confirm Checkout</button>
                </form>
            </div>
        </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#cardFields').hide();
            
            $('input[name="paymentMethod"]').change(function() {
                $(this).val() === 'credit' ? $('#cardFields').show() : $('#cardFields').hide();
            });
            
            $('#checkoutForm').submit(function(e) {
                e.preventDefault();
                let valid = true;
                
                const validateField = (field, condition) => {
                    condition ? $(field).addClass('is-invalid') && (valid = false) : $(field).removeClass('is-invalid');
                };
                
                validateField('#fullname', $('#fullname').val().length < 3);
                validateField('#email', !$('#email').val().includes('@'));
                validateField('#phone', $('#phone').val().length < 10);
                validateField('#address', $('#address').val().length === 0);
                validateField('#city', $('#city').val().length === 0);
                validateField('#postalcode', $('#postalcode').val().length < 4);
                validateField('#country', $('#country').val() === '');
                validateField('#terms', !$('#terms').is(':checked'));
                
                if (!$('input[name="paymentMethod"]:checked').val()) {
                    alert('Please select a payment method');
                    valid = false;
                } else {
                    if ($('input[name="paymentMethod"]:checked').val() === 'credit') {
                        validateField('#cc-name', $('#cc-name').val().length === 0);
                        validateField('#cc-number', $('#cc-number').val().length === 0);
                        validateField('#cc-expiration', $('#cc-expiration').val().length === 0);
                        validateField('#cc-cvv', $('#cc-cvv').val().length === 0);
                    }
                }
                
                if (valid) this.submit();
            });
        });
    </script>
</div>